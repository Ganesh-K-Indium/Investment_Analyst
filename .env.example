# ─────────────────────────────────────────────────────────────────────────────
# Investment Analyst: environment file. Copy to .env and fill in.
#
# Where settings come from (first match wins):
#   real environment variables  >  this .env file  >  config.yaml  >  built-in defaults
#
# This file holds secrets and connection strings. Every other setting (pools, workers, limits, document reading,
# MCP servers, and the defaults users start from in the Settings screen) is listed with its default in
# config.example.yaml, and can go here or in config.yaml under the same name.
#
# Check what is in force:   cd backend && python -m app.core.config
# Generate a secret:        python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# development | production. production refuses to start without the four secrets below and safe CORS.
APP_ENV=development
LOG_LEVEL=INFO

# ── Required services ────────────────────────────────────────────────────────
# Postgres. Running the app on your machine against `docker compose up postgres` (published on 5433):
DATABASE_URL=postgresql://investment_analyst:investment_analyst@localhost:5433/investment_analyst
# Inside docker compose the api/workers use the service name instead (set in docker-compose.yml).

# Initial role and database for the compose Postgres container.
POSTGRES_USER=investment_analyst
POSTGRES_PASSWORD=investment_analyst
POSTGRES_DB=investment_analyst

# Redis (job queues and live updates).
REDIS_URL=redis://localhost:6379/0

# Qdrant (vectors): the compose container, or Qdrant Cloud with an API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Docker only ──────────────────────────────────────────────────────────────
# Inside `docker compose`, the api and workers reach Postgres, Redis and Qdrant by service name, whatever the three URLs
# above say. To point the containers at managed services (or Qdrant Cloud) instead, set these:
# COMPOSE_DATABASE_URL=
# COMPOSE_REDIS_URL=
# COMPOSE_QDRANT_URL=
# Web UI container (docker compose --profile ui): where the browser reaches the API, and the UI's port.
# VITE_API_BASE_URL=http://localhost:8000
# UI_PORT=3000

# ── Required keys ────────────────────────────────────────────────────────────
# OpenAI: embeddings for all search, filing captions and the default models. Required.
OPENAI_API_KEY=
# Google: Gemini vision for quant chart summaries.
GOOGLE_API_KEY=
# FRED: macro data (https://fred.stlouisfed.org/docs/api/api_key.html).
FRED_API_KEY=
# SEC asks every EDGAR client to identify itself: "Company contact@company.com".
SEC_USER_AGENT=

# ── Secrets (required when APP_ENV=production) ───────────────────────────────
# Signs login tokens. Unset in development = a random key per start (everyone is signed out on restart).
JWT_SECRET_KEY=
# Encrypts model-provider keys users save in Settings. Changing it makes saved keys unreadable.
APP_SECRET_KEY=
# Encrypts stored connector credentials (S3, SharePoint, Google Drive, databases...).
INTEGRATION_SECRET_KEY=
# Signs the per-request token the Postgres MCP tool verifies.
MCP_SHARED_SECRET=

# ── Web UI origins ───────────────────────────────────────────────────────────
# Comma-separated origins of the web UI. In production also set CORS_ALLOWED_ORIGIN_REGEX= (empty).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Optional keys ────────────────────────────────────────────────────────────
# Web search (research agent, web fallback, ALPHA horizon/action).
TAVILY_API_KEY=
# Extra macro series.
BLS_API_KEY=
# Server-wide model providers for users who save no key of their own.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
OPENAI_BASE_URL=
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=
# Hosted re-ranker (the default re-ranker runs locally).
COHERE_API_KEY=
# Chart image hosting (charts still work without it).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
