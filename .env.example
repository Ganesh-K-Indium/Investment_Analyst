# OpenAI API Key (Required)
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant Vector Database (Required)
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here

# Groq API Key (Optional - for alternative LLM)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Optional - for web search)
# Tavily API Key (Optional - for web search)
TAVILY_API_KEY=your_tavily_api_key_here

# Google API Key (Required for Chart Summary)
GOOGLE_API_KEY=your_google_api_key_here

# Google API Key (Required for Chart Summary)
GOOGLE_API_KEY=your_google_api_key_here

# Database Configuration
# Postgres is the supported database (async via asyncpg at runtime, sync
# psycopg2 for Alembic migrations — both derived from this one URL).
#
# Local dev via `docker compose up` (from *inside* the api container, talking
# to the "postgres" service on its internal port):
#   DATABASE_URL=postgresql://investment_analyst:investment_analyst@postgres:5432/investment_analyst
# Local dev running the app directly on the host (not via compose) — compose
# publishes Postgres on host port 5433, not 5432, to avoid clashing with a
# machine-local Postgres install:
#   DATABASE_URL=postgresql://investment_analyst:investment_analyst@localhost:5433/investment_analyst
# AWS (RDS):
#   DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/<db_name>
DATABASE_URL=postgresql://investment_analyst:investment_analyst@localhost:5433/investment_analyst

POSTGRES_USER=investment_analyst
POSTGRES_PASSWORD=investment_analyst
POSTGRES_DB=investment_analyst

# Redis (background job queue — Arq). Backs both the "interactive" and
# "batch" analysis-run queues.
# Local dev via `docker compose up` (from inside the api/worker containers):
#   REDIS_URL=redis://redis:6379/0
# Local dev running directly on the host:
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Authentication
# JWT_SECRET_KEY is REQUIRED when APP_ENV=production (the app refuses to
# start without it) — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# In development, if unset, a random secret is generated per process start.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of origins allowed to call this API with credentials
# (cookies) — must exactly match the frontend's deployed origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
