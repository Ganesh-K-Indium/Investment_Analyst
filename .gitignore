# Generated / noise files
*.json
# Exceptions the app needs in git: the document engine's built-in templates, and the diagram in docs/ARCHITECTURE.md
!backend/app/docproc/templates/*.json
!docs/ocr_pipeline.png
*.ttf
# Fonts used by app/services/pdf_render.py must stay visible
!backend/app/assets/fonts/*.ttf

# Deployment configuration (copy config.example.yaml); may hold deployment-specific values
/config.yaml

# Tool caches (uv, used by scripts/dev.py lock)
/.cache/

# ── Web UI (frontend/) ──────────────────────────────────────────────────────
# Its build output and local settings stay out of git...
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.*
!frontend/.env.example
# ...but its config, lock file, images and src/lib must be committed despite the broad *.json / *.png / lib/ rules above.
!frontend/*.json
!frontend/src/**/*.json
!frontend/src/assets/**
!frontend/public/**
!frontend/src/lib/
